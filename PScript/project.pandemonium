; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "WorldGenBaseResource",
"class": @"Continent",
"language": @"PScript",
"path": "res://addons/world_generator/resources/continent.p"
}, {
"base": "WorldGenBaseResource",
"class": @"SubZone",
"language": @"PScript",
"path": "res://addons/world_generator/resources/subzone.p"
}, {
"base": "WorldGenBaseResource",
"class": @"SubZoneProp",
"language": @"PScript",
"path": "res://addons/world_generator/resources/sub_zone_prop.p"
}, {
"base": "TerrainLevelGenerator",
"class": @"TerrainWorldGenerator",
"language": @"PScript",
"path": "res://scripts/world_generators/TerrainWorldGenerator.p"
}, {
"base": "Resource",
"class": @"WorldGenBaseResource",
"language": @"PScript",
"path": "res://addons/world_generator/resources/world_gen_base_resource.p"
}, {
"base": "Reference",
"class": @"WorldGenRaycast",
"language": @"PScript",
"path": "res://addons/world_generator/raycast/world_gen_raycast.p"
}, {
"base": "WorldGenBaseResource",
"class": @"WorldGenWorld",
"language": @"PScript",
"path": "res://addons/world_generator/resources/world_gen_world.p"
}, {
"base": "Resource",
"class": @"WorldGeneratorSettings",
"language": @"PScript",
"path": "res://addons/world_generator/resources/world_generator_settings.p"
}, {
"base": "WorldGenBaseResource",
"class": @"Zone",
"language": @"PScript",
"path": "res://addons/world_generator/resources/zone.p"
} ]
_global_script_class_icons={
"Continent": "",
"SubZone": "",
"SubZoneProp": "",
"TerrainWorldGenerator": "",
"WorldGenBaseResource": "",
"WorldGenRaycast": "",
"WorldGenWorld": "",
"WorldGeneratorSettings": "",
"Zone": ""
}

[application]

config/name="World Generator"
run/main_scene="res://terraman/Terraman.tscn"
config/icon="res://icon.png"

[editor]

default_language=2

[editor_plugins]

enabled=PoolStringArray( "res://addons/world_generator/plugin.cfg" )

[physics]

common/enable_pause_aware_picking=true

[rendering]

vram_compression/import_etc=true
vram_compression/import_etc2=false
environment/default_environment="res://default_env.tres"
